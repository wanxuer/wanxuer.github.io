ype":"linear","angle":90,"gradient":[{"A":"#3a86c5"},{"A":"#73b4e9","C":0.5},{"A":"#ddf3c0","C":1}]},"elements":[{"id":"case-narrative-4-title-v3-flow","type":"text","text":"音量工具——\n用户增长与商业化实践","x":1020,"y":320,"width":510,"height":105,"fontSize":40,"font":"serif","fontWeight":500,"color":"#214e70","lineHeight":1.3,"rotation":0,"opacity":1,"align":"start","fit":false,"wordWrap":true,"cjkPunctuation":true,"baseline":35.2},{"id":"case-narrative-4-body-v3-flow","type":"text","text":"音量工具上线初期，面临使用需求小众、广告变现较弱的问题。通过竞品分析与使用场景梳理，增加相关功能，调整首次使用流程，并结合通知与悬浮窗触达，提升用户活跃与广告展示机会。在持续迭代过程中，次日留存从 10% 提升至 40%，日均 ROI 从 20% 提升至 150%。","x":1020,"y":430,"width":520,"height":320,"fontSize":26,"font":"serif","fontWeight":400,"color":"#214e70","lineHeight":1.6,"rotation":0,"opacity":1,"align":"start","fit":false,"wordWrap":true,"cjkPunctuation":true,"baseline":22.88,"flowWidths":[520,520,520,520,440]}],"fontScale":1,"artwork":"/portfolio/artwork-4.webp","parallaxLayers":[{"name":"page-4-0","src":"/portfolio/layers/page-4-0.webp?v=original-20261019","parallax":{"x":0,"y":0}},{"name":"page-4-1","src":"/portfolio/layers/page-4-1.webp?v=original-20261019","parallax":{"x":0.35,"y":0.16}},{"name":"page-4-2","src":"/portfolio/layers/page-4-2.webp?v=original-20261019","parallax":{"x":0,"y":0}},{"name":"page-4-3","src":"/portfolio/layers/page-4-3.webp?v=original-20261019","parallax":{"x":1.0,"y":0.5}},{"name":"page-4-4","src":"/portfolio/layers/page-4-4.webp?v=original-20261019","parallax":{"x":1.1,"y":0.5}}],"typographyRevision":"case-narrative-v3-flow"},{"number":5,"width":1659,"height":948,"background":{"gradient":[{"A":"#b4a6e3"},{"A":"#d5baee","C":0.5},{"A":"#b1d4f7","C":1}],"center":90,"type":"linear","angle":90},"elements":[{"id":"LBDdpJxgZrbwpWsf","type":"text","x":39.640741502455995,"y":415.63866395478067,"width":487.8764111772495,"height":140.93197562918266,"rotation":-4.654094942190735,"opacity":1,"text":"动作分析","fontSize":117.797,"color":"#f3f5f0","align":"center","font":"serif","lineHeight"